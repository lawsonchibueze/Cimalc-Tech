# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/cimalc
# Only for databases behind a connection pooler such as Neon. The direct, non-pooled
# address, used by `prisma migrate`. Neon: the same host without "-pooler".
DIRECT_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Address Better Auth builds links from, including the Google redirect address
# BETTER_AUTH_URL/api/auth/callback/google. When the site proxies /api/auth to this API,
# set this to the SITE address, and register that redirect address in Google Cloud Console.
BETTER_AUTH_URL=http://localhost:8000

# --- Frontend origins ---
# Comma separated list of exact origins allowed for CORS and auth redirects.
UI_URL=http://localhost:3000

# --- Optional ---
PORT=8000

# Set when the site and API are subdomains of one domain, for example example.com.
# Makes the session cookie first party so browsers do not block it.
COOKIE_DOMAIN=

# Existing accounts with these emails are promoted to ADMIN when the API starts.
# Sign up first, add the address here, then restart the API.
ADMIN_EMAILS=

# Google sign-in. Both values are needed to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 image storage. R2_PUBLIC_URL must also be set as
# NEXT_PUBLIC_MEDIA_URL in the frontend so product images can be displayed.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email through Resend. Without these the API logs emails instead of sending them.
RESEND_API_KEY=
MAIL_FROM="Cimalc Tech <hello@example.com>"
# Receives new quote requests and contact messages.
STAFF_NOTIFY_EMAIL=
