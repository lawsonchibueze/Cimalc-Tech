# Address of the API. Server side only. The site forwards /backend and /api/auth here,
# so the browser only ever talks to this site and sign-in cookies stay first party.
BACKEND_URL=http://localhost:8000

# Leave unset. Setting it makes the browser call the API directly, which brings back
# cross-site cookie problems in Safari, Firefox and private windows.
# NEXT_PUBLIC_API_URL=

# Public URL of this site. Used for canonical links, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Same value as R2_PUBLIC_URL in the API. Lets next/image optimise product photos.
NEXT_PUBLIC_MEDIA_URL=

# Optional. Overrides the official contact email, cimalct@gmail.com, for example on a staging site.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. Set to true to redirect signed out visitors before the page loads.
# Only works when the site and API share a domain, see COOKIE_DOMAIN in the API.
AUTH_ENFORCE_PROTECTION=false
